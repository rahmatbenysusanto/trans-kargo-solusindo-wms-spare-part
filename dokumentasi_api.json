    "/outbound/{id}": {
      "get": {
        "summary": "Get Detailed Outbound Transaction",
        "tags": [
          "Transactions"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "ID of the outbound transaction"
          }
        ],
        "responses": {
          "200": {
